# Copy to .env for local tooling only. Never commit real values.
# Worker local secrets belong in apps/web/.dev.vars (also gitignored).

# Cloudflare API (deploy scripts / CI secrets mirror these names)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Playwright e2e base URL (defaults to https://hisfm.dev.hexly.ai)
HISFM_E2E_BASE_URL=

# Optional: path to Workflow image-generation generate.py when running artwork/*.py
# HISFM_IMAGE_HELPER=/path/to/agi-image-generation/scripts/generate.py

# Azure OpenAI GPT Image (artwork generation); same names the Workflow skill reads
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
