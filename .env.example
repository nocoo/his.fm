# Copy to .env for local tooling only. Never commit real values.
# Worker local secrets belong in apps/web/.dev.vars (also gitignored).

# Cloudflare API (deploy scripts / CI secrets mirror these names)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Playwright e2e base URL (defaults to https://hisfm.dev.hexly.ai)
HISFM_E2E_BASE_URL=

# Optional override for the system0 image-generation-gpt helper (defaults to ~/.agents/skills/image-generation-gpt/scripts/generate.py)
# HISFM_IMAGE_HELPER=/path/to/image-generation-gpt/scripts/generate.py

# GPT Image credentials live in ~/.config/system0/image-generation.json (never stored in this repo)
