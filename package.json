{
  "name": "his-fm",
  "version": "2.4.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @his-fm/web",
    "build": "npm run build --workspace @his-fm/web",
    "preview": "npm run preview --workspace @his-fm/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @his-fm/web",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @his-fm/web",
    "cf:typegen": "npm run cf:typegen --workspace @his-fm/web",
    "deploy": "npm run deploy --workspace @his-fm/web",
    "lint": "biome check . --error-on-warnings",
    "format": "biome check . --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "husky": "9.1.7"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "sharp": "0.35.5",
    "@codemirror/view": "6.43.14",
    "@codemirror/language": "6.13.1"
  }
}
