{
  "name": "his-fm",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 7056",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "format": "biome check . --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "cf:typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --strict-vars=false",
    "deploy": "npm run build && wrangler deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@lezer/highlight": "1.2.3",
    "@nocoo/basalt": "2.1.8",
    "@uiw/react-codemirror": "4.25.11",
    "jose": "6.2.12",
    "lucide-react": "1.47.0",
    "marked": "18.0.13",
    "motion": "13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "1.55.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "husky": "9.1.7",
    "miniflare": "5.20260917.0-alpha",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.140.0"
  }
}
