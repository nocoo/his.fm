{
  "name": "his-fm",
  "version": "2.3.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @his-fm/web",
    "build": "npm run build --workspace @his-fm/web",
    "preview": "npm run preview --workspace @his-fm/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @his-fm/web",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @his-fm/web",
    "cf:typegen": "npm run cf:typegen --workspace @his-fm/web",
    "deploy": "npm run deploy --workspace @his-fm/web",
    "lint": "biome check . --error-on-warnings",
    "format": "biome check . --write",
    "prepare": "husky",
    "agent": "npm run start --workspace @his-fm/agent --",
    "dev:all": "node --experimental-strip-types packages/agent/src/dev.ts",
    "agent:debug": "node --experimental-strip-types packages/agent/src/debug.ts",
    "agent:inspect": "node --inspect=127.0.0.1:37056 --experimental-strip-types packages/agent/src/cli.ts start --environment local"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "husky": "9.1.7"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "sharp": "0.35.5",
    "@earendil-works/pi-ai": "1.1.0",
    "@codemirror/view": "6.43.14",
    "@codemirror/language": "6.13.1"
  }
}
